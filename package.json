{
  "name": "bet-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/deploy-build.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --require ./scripts/node-userinfo-fallback.cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:grant-role": "tsx scripts/grant-app-role.ts",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "dev:stack": "tsx scripts/dev-stack.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "odds:capture": "tsx scripts/capture-odds-fixtures.ts",
    "odds:contract": "tsx scripts/odds-contract.ts",
    "admin:smoke": "tsx scripts/smoke-admin.ts",
    "env:push": "tsx scripts/push-env-railway.ts",
    "dev:inngest": "npx --yes inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "dev:all": "concurrently -n next,inngest -c blue,magenta \"npm:dev:local\" \"npm:dev:inngest\"",
    "bet:watch": "tsx scripts/qa-check-bet.ts",
    "bench:sync": "tsx scripts/bench-sync-fixtures.ts",
    "production:check": "tsx scripts/production-check.ts",
    "ci:secrets": "node scripts/secret-scan.mjs",
    "ci:migrations": "node scripts/check-migrations.mjs",
    "settle:watch": "tsx scripts/watch-settlement.ts",
    "dev:local": "node scripts/dev-app-inngest-mode.mjs",
    "db:clean-benchmark": "tsx scripts/clean-benchmark-data.ts",
    "db:verify-restore": "tsx scripts/verify-restore.ts",
    "db:audit-roles": "tsx scripts/audit-db-roles.ts",
    "readiness:demo": "tsx scripts/production-check.ts",
    "readiness:real-money": "tsx scripts/production-check.ts --mode=real-money",
    "db:verify-cleanup": "tsx scripts/verify-benchmark-cleanup.ts",
    "db:repair-exposure": "tsx scripts/repair-residual-exposure.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@sentry/nextjs": "10.70.0",
    "argon2": "0.45.1",
    "dotenv": "17.2.2",
    "drizzle-orm": "0.45.2",
    "inngest": "4.18.1",
    "ioredis": "^5.11.1",
    "next": "16.3.2",
    "next-auth": "4.24.15",
    "postgres": "3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "concurrently": "^10.0.5",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.2",
    "fast-check": "4.9.0",
    "redis-memory-server": "^0.17.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
