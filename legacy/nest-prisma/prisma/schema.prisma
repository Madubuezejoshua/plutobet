// Money-critical constraints — CHECK constraints, the balance-trigger, the
// partial unique indexes, immutability rules, and the house-wallet seed rows
// — are NOT declared here. Prisma's schema DSL can't express them, and the
// build instructions are explicit: those live as raw SQL in
// prisma/migrations/20260822120000_ledger_and_wallets/migration.sql.
// This file only has to agree with that SQL on table/column shape so future
// `prisma migrate dev` diffs don't fight it — Prisma ignores DB objects it
// has no declaration for, so the raw SQL additions persist across
// schema-driven migrations untouched.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WalletCurrency {
  NGN

  @@map("wallet_currency")
}

enum WalletKind {
  user
  house

  @@map("wallet_kind")
}

enum HouseAccount {
  cash_in
  cash_out
  stakes_liability
  payouts_payable
  bonus_liability
  adjustments_equity

  @@map("house_account")
}

enum LedgerDirection {
  debit
  credit

  @@map("ledger_direction")
}

enum TransactionType {
  deposit
  withdrawal
  stake
  payout
  refund
  bonus
  adjustment
  transfer

  @@map("transaction_type")
}

enum ActorType {
  user
  admin
  system

  @@map("actor_type")
}

enum EventStatus {
  pending
  live
  settled
  cancelled

  @@map("event_status")
}

enum MarketStatus {
  open
  suspended
  settled
  void

  @@map("market_status")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wallets Wallet[]

  @@map("users")
}

model Wallet {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind   WalletKind @default(user)
  userId String?    @map("user_id") @db.Uuid
  // Uniqueness on (userId, currency) / (houseAccount, currency) is enforced
  // by partial indexes in raw SQL, not declared here — see header comment.
  houseAccount       HouseAccount?  @map("house_account")
  currency           WalletCurrency @default(NGN)
  cachedBalanceMinor BigInt?        @map("cached_balance_minor")
  version            BigInt         @default(0)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  user          User?         @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]

  @@map("wallets")
}

model Transaction {
  id   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type TransactionType
  // @unique here (not @@unique in a block) generates the exact same plain,
  // full-column unique index our raw SQL already creates
  // (uq_transactions_idempotency_key) — Prisma's migrate diffing matches on
  // index structure, not name, so this doesn't produce a second index. It's
  // declared because WalletService relies on typed findUnique() by this
  // field; that's the only reason it differs from `reference` below.
  idempotencyKey String @unique @map("idempotency_key")
  // NOT @unique: our raw SQL index is PARTIAL (`WHERE reference IS NOT
  // NULL`), which is structurally different from the full index Prisma
  // would generate for a plain @unique on a nullable column — declaring it
  // here would add a redundant second index. Query this with findFirst()
  // or raw SQL, never findUnique().
  reference String?
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  metadata  Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ledgerEntries LedgerEntry[]

  @@map("transactions")
}

model LedgerEntry {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId     String          @map("transaction_id") @db.Uuid
  walletId          String          @map("wallet_id") @db.Uuid
  direction         LedgerDirection
  amountMinor       BigInt          @map("amount_minor")
  balanceAfterMinor BigInt?         @map("balance_after_minor")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  transaction Transaction @relation(fields: [transactionId], references: [id])
  wallet      Wallet      @relation(fields: [walletId], references: [id])

  @@map("ledger_entries")
}

model Event {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider         String
  providerEventId  String      @map("provider_event_id")
  sport            String
  league           String
  home             String
  away             String
  startsAt         DateTime    @map("starts_at") @db.Timestamptz(6)
  status           EventStatus @default(pending)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @default(now()) @map("updated_at") @db.Timestamptz(6)

  markets Market[]

  @@unique([provider, providerEventId])
  @@map("events")
}

model Market {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String       @map("event_id") @db.Uuid
  // Valid values enforced by a raw SQL CHECK, not declared here — see
  // migration.sql. Keep in sync with MarketKey in src/odds/provider.ts.
  key       String
  status    MarketStatus @default(open)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  event      Event       @relation(fields: [eventId], references: [id])
  selections Selection[]

  @@unique([eventId, key])
  @@map("markets")
}

model Selection {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  marketId             String       @map("market_id") @db.Uuid
  key                  String
  label                String
  line                 Decimal?     @db.Decimal(6, 2)
  currentPriceDecimal  Decimal      @map("current_price_decimal") @db.Decimal(7, 3)
  status               MarketStatus @default(open)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  market Market @relation(fields: [marketId], references: [id])

  @@unique([marketId, key])
  @@map("selections")
}

model OddsSnapshot {
  id                BigInt   @id @default(autoincrement())
  provider          String
  providerEventId   String   @map("provider_event_id")
  payload           Json
  fetchedAt         DateTime @map("fetched_at") @db.Timestamptz(6)

  @@map("odds_snapshots")
}
// Archived pre-migration Prisma schema; excluded from the active build.
