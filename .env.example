# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# Ordinary reads may use Neon's pooled PgBouncer endpoint.
# Vercel Postgres integrations may provide POSTGRES_URL instead.
DATABASE_URL="postgresql://app_user:change-me@localhost:5432/bet"

# Every wallet transaction must use an unpooled endpoint. Never point this at
# Neon's `-pooler` hostname: pgBouncer in transaction mode silently breaks the
# SELECT ... FOR UPDATE the ledger depends on, and the resulting double-spends
# only appear under load.
# Vercel Neon/Postgres integrations may provide DATABASE_URL_UNPOOLED or
# POSTGRES_URL_NON_POOLING instead.
DIRECT_DATABASE_URL="postgresql://app_user:change-me@localhost:5432/bet"

# Production migrations should run as an owner role, while both runtime URLs
# above use a non-owner role. Local development can omit this and fall back to
# DIRECT_DATABASE_URL.
MIGRATION_DATABASE_URL="postgresql://bet_owner:change-me@localhost:5432/bet"
APP_DATABASE_ROLE="app_user"

# ---------------------------------------------------------------------------
# CACHE / LOCKS  (Upstash in production — rediss:// over TLS)
# ---------------------------------------------------------------------------
# Holds the odds rate budget, poller cadence, and API rate limits. All three
# must be shared across serverless instances, so this cannot be in-process.
# Vercel's Upstash integration may provide the equivalent KV_URL.
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
AUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# IDENTITY
# ---------------------------------------------------------------------------
# Pepper for BVN/NIN digests. Minimum 32 characters.
#
# TREAT AS PERMANENT KEY MATERIAL. Every stored identity digest is derived
# from it, and you cannot re-collect BVNs to re-hash them — so it cannot be
# rotated. Back it up, restrict access, never commit it. If it leaks, the
# 11-digit keyspace becomes brute-forceable and every stored identity should
# be considered exposed.
IDENTITY_PEPPER=""

# ---------------------------------------------------------------------------
# ODDS  (dev tier: 100 req/hour, 500 req/day, 2 bookmakers)
# ---------------------------------------------------------------------------
# Run `npx tsx scripts/probe-odds.ts` before trusting the adapter: every field
# name in it is currently a best-effort reading of the docs, and settlement
# depends on `periods.ft` parsing correctly.
ODDS_API_KEY=""

# ---------------------------------------------------------------------------
# PAYMENTS
# ---------------------------------------------------------------------------
# Used to verify webhook signatures (HMAC-SHA512 over the raw body).
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# KYC DOCUMENT STORAGE  (Backblaze B2, S3-compatible API)
# ---------------------------------------------------------------------------
# The bucket MUST be private. Documents are never served directly; reads go
# through short-lived signed URLs. A public KYC bucket is an identity-document
# breach waiting to be indexed by a crawler.
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_REGION="us-east-005"
B2_BUCKET=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""

# ---------------------------------------------------------------------------
# JOBS / MONITORING
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""
SENTRY_DSN=""
